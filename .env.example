# Sunchaser local secrets. Copy to .env (gitignored). In production this
# becomes /etc/sunchaser.env (mode 600) loaded by systemd EnvironmentFile.

# Fireworks key for the default verdict model (DeepSeek V4 Flash).
# FIREWORKS_API_KEY=fw_...

# Anthropic key, only needed for `verdict --deep` (claude-opus-4-8).
# ANTHROPIC_API_KEY=sk-ant-...
